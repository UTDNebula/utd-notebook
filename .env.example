# Local application
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-private-secret-at-least-32-characters

# OAuth
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
DISCORD_CLIENT_ID=replace-with-discord-client-id
DISCORD_CLIENT_SECRET=replace-with-discord-client-secret

# Database
DATABASE_URL=postgresql://username:password@localhost:5432/database

# Nebula API storage
NEBULA_API_URL=https://api.example.com
NEBULA_API_STORAGE_BUCKET=replace-with-storage-bucket
NEBULA_API_KEY=replace-with-nebula-api-key
NEBULA_API_STORAGE_KEY=replace-with-storage-key

# Optional observability
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_SENTRY_DSN=
