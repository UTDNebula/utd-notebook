# Create a .env file using this template

# --- DATABASE URL ---
# PostgreSQL connection string for your database
DATABASE_URL=

# --- ACCOUNT AUTHENTICATION ---
# Use "http://localhost:3000" for local development
BETTER_AUTH_URL=http://localhost:3000
# Generate by running `openssl rand -base64 32` in your terminal
BETTER_AUTH_SECRET=

# Client IDs and secrets for signing in with these providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# --- NEBULA API ---
NEBULA_API_URL=https://api.utdnebula.com
NEBULA_API_STORAGE_BUCKET=jupiter
NEBULA_API_KEY=
NEBULA_API_STORAGE_KEY=

# --- OPTIONAL ---
# Variables used to connect to Sentry. Used in production.
# Auth token is used for managing Sentry
SENTRY_AUTH_TOKEN=
# Endpoint URL that the client sends data to
NEXT_PUBLIC_SENTRY_DSN=