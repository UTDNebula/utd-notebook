    "eslint-plugin-react-hooks": "^7.1.1",
    "jest": "^30.4.2",
    "postcss": "^8.5.15",
    "prettier": "^3.8.4",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4.3.1",
    "tailwindcss-animate": "^1.0.7",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.1",
    "typescript": "^6.0.3"
